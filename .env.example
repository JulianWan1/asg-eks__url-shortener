# Copy to .env for local `npm run dev` (not needed if you use docker compose).
# Config is read from the environment only — the same image runs everywhere
# with just these three vars changed.

# Port the HTTP server listens on.
PORT=3000

# Postgres connection string. For a local Postgres:
DATABASE_URL=postgres://shortener:localdev@localhost:5432/shortener

# One of: debug | info | warn | error
LOG_LEVEL=debug

# Optional: grace period (ms) to drain in-flight requests on SIGTERM.
# SHUTDOWN_TIMEOUT_MS=10000
