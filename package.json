{
  "name": "url-shortener",
  "version": "0.1.0",
  "description": "Deliberately-simple URL shortener — the stateless workload for the devops-lab project. Its job is to be too simple to be wrong so the infrastructure is the only variable.",
  "license": "MIT",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
